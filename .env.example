# Network
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ENDPOINT=/mcp
# MCP_PUBLIC_URL=https://mcp.example.com
# Non-zero trust-proxy hops are accepted only when MCP_HOST is loopback.
MCP_TRUST_PROXY_HOPS=0

# Authentication.
# Static bearer is simplest for private clients.
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_ALLOW_NO_AUTH=false

# External OAuth resource-server mode.
# Jeopsok verifies JWT access tokens but does not issue tokens or run DCR/PKCE endpoints.
MCP_OAUTH_ENABLED=false
# MCP_OAUTH_ISSUER=https://idp.example.com/
# MCP_OAUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
# MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=mcp:tools

# Safe-by-default permissions.
# readonly  = list/stat/read/download only
# workspace = read/write/transfer/delete inside allowed roots (default)
# operator  = workspace + allowlisted command/process tools
# full      = unrestricted host access + optional CodeAct
JEOPSOK_PROFILE=workspace
MCP_DEFAULT_CWD=/tmp/jeopsok-workspace
# If omitted outside full profile, defaults to MCP_DEFAULT_CWD.
JEOPSOK_ALLOWED_ROOTS=/tmp/jeopsok-workspace
# Required only for operator. '*' explicitly disables the command allowlist.
# JEOPSOK_ALLOWED_COMMANDS=git,npm,node
# Optional environment-variable names that operator commands may override.
# JEOPSOK_ALLOWED_ENV=CI,NODE_ENV
MCP_DEFAULT_SHELL=/bin/bash

# CodeAct is exposed only in full profile. It runs persistent Python with host authority.
MCP_CODEACT_ENABLED=true
# MCP_CODEACT_PYTHON=python3
MCP_CODEACT_MAX_SESSIONS=8
MCP_CODEACT_SESSION_RETENTION_MS=3600000
MCP_CODEACT_INTERACTIVE_MAX_ACTIONS=24
MCP_CODEACT_INTERACTIVE_MAX_EXECUTION_CALLS=32
# MCP_CODEACT_LOG_FILE=/var/lib/jeopsok/codeact-actions.jsonl
# MCP_CODEACT_RUN_STATE_DIR=/var/lib/jeopsok/runs
# Only this server-owned variable may enable unattended sessions.
# MCP_RUN_MODE=unattended

# Operational limits.
MCP_MAX_REQUEST_BODY=8mb
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_PROCESS_RETENTION_MS=3600000
MCP_MAX_PROCESSES=128
MCP_MAX_FILE_CHUNK_BYTES=1048576
MCP_MAX_EDIT_FILE_BYTES=67108864
