# Network
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ENDPOINT=/mcp
# MCP_PUBLIC_URL=https://mcp.example.com
MCP_TRUST_PROXY_HOPS=0

# Authentication. Set MCP_ALLOW_NO_AUTH=true only behind a trusted private tunnel/gateway.
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_ALLOW_NO_AUTH=false

# Safe-by-default permissions.
# readonly  = list/stat/read/download only
# workspace = read/write/transfer/delete inside allowed roots (default)
# operator  = workspace + allowlisted command/process tools
# full      = unrestricted host command/filesystem access (explicit opt-in)
JEOPSOK_PROFILE=workspace
MCP_DEFAULT_CWD=/tmp/jeopsok-workspace
# If omitted outside full profile, defaults to MCP_DEFAULT_CWD.
JEOPSOK_ALLOWED_ROOTS=/tmp/jeopsok-workspace
# Required only for operator. '*' explicitly disables the command allowlist.
# JEOPSOK_ALLOWED_COMMANDS=git,npm,node
# Optional environment-variable names that operator commands may override.
# JEOPSOK_ALLOWED_ENV=CI,NODE_ENV
MCP_DEFAULT_SHELL=/bin/bash

# Operational limits.
MCP_MAX_REQUEST_BODY=8mb
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_PROCESS_RETENTION_MS=3600000
MCP_MAX_PROCESSES=128
MCP_MAX_FILE_CHUNK_BYTES=1048576
MCP_MAX_EDIT_FILE_BYTES=67108864
