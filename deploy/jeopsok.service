[Unit]
Description=Jeopsok MCP Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jeopsok
Group=jeopsok
WorkingDirectory=/opt/jeopsok
EnvironmentFile=/etc/jeopsok.env
ExecStart=/usr/bin/node /opt/jeopsok/dist/src/server.js
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=65535
UMask=0077

[Install]
WantedBy=multi-user.target
